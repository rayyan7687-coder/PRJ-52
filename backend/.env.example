# Backend Environment Configuration Template

# Database connection string (SQLite default, PostgreSQL in production)
DATABASE_URL=sqlite:///./buildloop.db

# JWT Secret Key
SECRET_KEY=your_backend_secret_key_change_in_production

# JWT Algorithm and Expiration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Maps API Key (Server-side)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend Email Service API Key
RESEND_API_KEY=your_resend_api_key

# CORS Allowed Origin
FRONTEND_URL=http://localhost:3000
