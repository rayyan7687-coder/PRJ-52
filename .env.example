# ==========================================
# BuildLoop - Environment Variable Template
# ==========================================
# Copy this file to `.env` or set these in your hosting provider environment settings.

# ------------------------------------------
# Backend Configuration
# ------------------------------------------
# Database Connection URL
# Development (SQLite): sqlite:///./buildloop.db
# Production (PostgreSQL): postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=sqlite:///./buildloop.db

# Security & Authentication Secrets
# Generate a strong random string in production (e.g., `openssl rand -hex 32`)
SECRET_KEY=your_production_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Cloud Services (OAuth & Maps)
# Obtain from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Cloudinary Storage Configuration
# Obtain from Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Resend)
# Obtain from Resend Dashboard: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# Monitoring (Sentry)
# Obtain from Sentry Settings: https://sentry.io
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Frontend Origin URL (for CORS setup)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------
# Frontend Configuration
# ------------------------------------------
# Backend API Base URL
VITE_API_URL=http://localhost:8000

# Frontend Google Maps JavaScript API Key
VITE_GOOGLE_MAPS_API_KEY=your_frontend_google_maps_api_key_here
